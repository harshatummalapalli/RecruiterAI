# Secrets
.env

# Virtual Environment
.venv/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Persisted search records (may contain real candidate data from live searches)
output/searches/
output/intake_sessions/
# Experiment artifacts (raw provider data / candidate PII)
output/experiments/
# Shadow-mode compiler divergence logs (candidate-derived) and confirmation store (real PII)
output/compiler_shadow/
output/confirmations/
# New-engine (recruiter/) runtime stores — sessions + confirmed briefs (real PII)
output/engine_intake_sessions/
output/confirmations_v2/
# Throwaway validation-run sessions/confirmations
output/_validate/
# Excel export artifacts (+ Office's ~$ lock files) — regenerated on demand, not source
output/*.xlsx
~$*.xlsx
# Local dev server logs
*_dev.log

# Local record-preview data (real candidate profiles)
output/record_preview/
frontend/src/preview-data/

# Archived local test/experiment search data (see archive/test-data/*/MANIFEST.json) — same PII concern as
# output/searches above, just relocated rather than deleted.
archive/

# Local process-supervision logs
*_restart*.log
# Throwaway validation-run capability-memory outputs. The REAL per-org learned
# memories (default/gmail.com/epiq/swiggy/dayzero.partners.json) stay tracked.
output/capability_memory/judge-val-*.json
output/capability_memory/phasea-*.json
output/capability_memory/careerfit-*.json
