OPENAI_API_KEY=
CRUSTDATA_API_KEY=

# CrustData /person/search retrieval sizing — backend-owned (Phase 3): the
# frontend never sets page size/pages, it just requests a search.
DISCOVERY_PAGE_SIZE=50
DISCOVERY_MAX_PAGES=1

# HarvestAPI (harvestapi.io) — second-stage candidate enrichment, applied
# only to the top HARVEST_ENRICHMENT_TOP_N baseline-ranked candidates per
# search, up to HARVEST_ENRICHMENT_CONCURRENCY requests in flight at once.
# Optional: leave HARVEST_API_KEY blank to disable Harvest entirely — search
# and ranking work identically either way.
HARVEST_API_KEY=
HARVEST_ENRICHMENT_TOP_N=25
HARVEST_ENRICHMENT_CONCURRENCY=3

# Google OAuth — from Google Cloud Console, OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
# The same value must also be set as VITE_GOOGLE_CLIENT_ID in frontend/.env
ALLOWED_EMAIL_DOMAIN=yourcompany.com

# A long random secret used to sign session cookies (not the same as any API key above)
SESSION_SECRET_KEY=
SESSION_MAX_AGE_SECONDS=43200
# Set to true only once the app is served over HTTPS
SESSION_COOKIE_SECURE=false
